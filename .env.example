# Supabase project → Settings → API. Copy to .env.local (and to Vercel → Project → Settings → Environment Variables).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only (never NEXT_PUBLIC_): Supabase → Project Settings → API Keys → Secret key.
# Lets the DSI portal create staff logins and reset passwords.
SUPABASE_SECRET_KEY=sb_secret_...
